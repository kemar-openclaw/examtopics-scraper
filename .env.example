# Exam Topics Scraper Configuration

# Browser settings
EXAMTOPICS_HEADLESS=true
EXAMTOPICS_BASE_URL=https://www.examtopics.com
EXAMTOPICS_TIMEOUT=30

# Output and cache
EXAMTOPICS_OUTPUT_DIR=./output
EXAMTOPICS_CACHE_DIR=./.cache
EXAMTOPICS_USER_DATA_DIR=./.browser_data

# Rate limiting (seconds)
EXAMTOPICS_REQUEST_DELAY_MIN=2.0
EXAMTOPICS_REQUEST_DELAY_MAX=5.0

# Retry configuration
EXAMTOPICS_MAX_RETRIES=3
EXAMTOPICS_RETRY_DELAY=5.0
EXAMTOPICS_RETRY_MULTIPLIER=2.0

# Anti-detection
EXAMTOPICS_USE_STEALTH=true
EXAMTOPICS_ROTATE_USER_AGENTS=true

# Proxy settings (optional)
EXAMTOPICS_USE_PROXY=false
EXAMTOPICS_PROXY_URL=http://user:pass@proxy:8080

# Scraping limits
EXAMTOPICS_MAX_PAGES=0
EXAMTOPICS_MAX_QUESTIONS=0
